{
  "name": "v1",
  "description": "Personal Website V1",
  "version": "1.0.0",
  "author": "Vandit U Shah <Vandit684@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vanditlion/VanditPortfolio"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "MIT",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "gatsby build",
    "develop": "NODE_OPTIONS='' gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "start": "NODE_OPTIONS='' npm run develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "deploy": "gatsby build && gh-pages -d public -b main"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,scss,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "animejs": "^3.2.1",
    "babel-plugin-styled-components": "^2.1.4",
    "core-js": "^3.48.0",
    "gatsby": "^5.12.9",
    "gatsby-image": "^3.11.0",
    "gatsby-plugin-google-analytics": "^5.12.0",
    "gatsby-plugin-image": "^3.12.3",
    "gatsby-plugin-manifest": "^5.12.3",
    "gatsby-plugin-netlify": "^5.1.0",
    "gatsby-plugin-offline": "^6.12.3",
    "gatsby-plugin-react-helmet": "^6.16.0",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-plugin-sharp": "^5.12.3",
    "gatsby-plugin-sitemap": "^6.12.3",
    "gatsby-plugin-styled-components": "^6.16.0",
    "gatsby-remark-external-links": "^0.0.4",
    "gatsby-remark-images": "^7.12.3",
    "gatsby-remark-prismjs": "^7.12.0",
    "gatsby-source-filesystem": "^5.12.1",
    "gatsby-transformer-remark": "^6.12.3",
    "gatsby-transformer-sharp": "^5.12.3",
    "lodash": "^4.17.21",
    "prismjs": "^1.29.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-is": "^19.2.4",
    "react-transition-group": "^4.4.5",
    "regenerator-runtime": "^0.14.1",
    "scrollreveal": "^4.0.9",
    "smooth-scroll": "^16.1.3",
    "styled-components": "^6.3.9"
  },
  "devDependencies": {
    "babel-eslint": "^10.1.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "gatsby-remark-code-titles": "^1.1.0",
    "gh-pages": "^6.1.0",
    "husky": "^4.3.8",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0"
  }
}
